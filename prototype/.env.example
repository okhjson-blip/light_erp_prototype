# 미설정 시 기본값: sqlite:///.../app/erp.db

# --- Neon Postgres (권장: 클라우드 개발/데모) ---
# Neon 콘솔 Connection string 복사.
# 마이그레이션/로컬 기동은 non-pooler(direct) 호스트 권장:
#   ep-xxxx.c-4....neon.tech   (O)
#   ep-xxxx-pooler.c-4....     (앱 런타임용으로도 가능하나 DDL 시 지연 가능)
# DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST/neondb?sslmode=require

# Neon Data API (rest/v1)는 이 FastAPI+SQLAlchemy 앱에서 사용하지 않음.
# NEON_DATA_API_URL=https://ep-xxxx.apirest....neon.tech/neondb/rest/v1

# --- 로컬 Docker Postgres (대안) ---
# docker compose up -d  후 아래 사용 (호스트 포트 5433)
# DATABASE_URL=postgresql+psycopg2://erp:erp_local_dev@127.0.0.1:5433/standard_erp

# JWT 서명 키 (운영 전환 시 반드시 교체)
# JWT_SECRET=change-me-in-production

# Light ERP Prototype 공통 접속 비밀번호
# ACCESS_PASSWORD=ax2026h2
# ACCESS_USER_EMAIL=admin@standard-erp.local
